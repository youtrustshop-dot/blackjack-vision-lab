{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blackjack Vision Lab",
  "version": "0.2.0",
  "identifier": "local.bjlab.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' http://127.0.0.1:* data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/bjlab-backend"],
    "resources": { "runtime/WebView2Loader.dll": "WebView2Loader.dll", "licenses/": "licenses/" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["English", "Italian"] } }
  }
}
